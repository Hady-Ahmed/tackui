# Agents are managed via the /agents admin page (stored in SQLite).
# These env vars are optional — only useful if you want to reference them
# in documentation or scripts. The frontend reads endpoints from the DB.

# Optional: SQLite database path for agent config + conversation history
# (shared with Better Auth for users/sessions).
# The parent directory is created automatically on first run if missing.
# AGENT_DB_PATH=./data/agent-state.db

# Optional: LangGraph agent (AG-UI endpoint via ag-ui-langgraph)
# LANGGRAPH_URL=http://localhost:8001/agent

# Optional: Agno agent (AG-UI endpoint)
# AGNO_URL=http://localhost:8000/agui

# ─── Auth ───────────────────────────────────────────────────────────────────
# Required unless AUTH_DISABLED=true. Generate a secret with:
#   openssl rand -hex 32
#
# Auth tables are auto-created on first request. To create them explicitly
# (e.g. before deploying), run: npx @better-auth/cli migrate --config lib/auth/auth.ts
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Solo / no-auth mode — skips login entirely (everyone is the single admin).
# Set to "true" for local dev or single-user self-hosted deployments.
# AUTH_DISABLED=false

# ─── Social providers (omit any you don't want) ────────────────────────────
# Google: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers → OAuth Apps
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ─── External OIDC SSO (for self-hosters with their own IdP) ───────────────
# Works with Keycloak, Authentik, Authelia, Okta, Entra, etc.
# OIDC_ISSUER must expose /.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=
