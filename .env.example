# ─── Quickstart ─────────────────────────────────────────────────────────────
# Easiest: docker-compose up (auto-migrates, bundles Postgres, AUTH_DISABLED=true)
#
# Manual:
#   1. DATABASE_URL=postgres://postgres:postgres@localhost:5432/agent_frontend
#   2. npm run migrate                                          (app tables)
#   3. npx @better-auth/cli migrate --config lib/auth/auth.ts   (auth tables)
#   4. BETTER_AUTH_SECRET=$(openssl rand -hex 32)
#   5. BETTER_AUTH_URL=http://localhost:3000
#   6. npm run dev  →  open http://localhost:3000
# First user to sign up becomes the admin. Then add agents via /agents.
#
# Or skip auth entirely: AUTH_DISABLED=true (solo mode).
#
# Note: changes to this file require a dev server restart (Ctrl+C → npm run dev).
# Next.js reads .env.local at boot; it does not hot-reload env vars.

# ─── Database ───────────────────────────────────────────────────────────────
# Required. Postgres connection string. Format:
#   postgres://USER:PASSWORD@HOST:PORT/DBNAME[?sslmode=require]
#
# Common values:
#   - Local Postgres:      postgres://postgres:postgres@localhost:5432/agent_frontend
#   - docker-compose:      postgres://postgres:postgres@db:5432/agent_frontend
#   - Neon (SaaS):         postgres://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
#   - Supabase (SaaS):     postgres://postgres:xxx@db.xxx.supabase.co:5432/postgres
#
# Optional pool tuning (defaults shown):
# PG_POOL_MAX=10
# PG_CONNECT_TIMEOUT=5000
DATABASE_URL=

# ─── Auth ───────────────────────────────────────────────────────────────────
# Required unless AUTH_DISABLED=true. Generate a secret with:
#   openssl rand -hex 32
#
# Auth tables (user, session, account, verification) are managed by Better Auth.
# Create them once before first boot:
#   npx @better-auth/cli migrate --config lib/auth/auth.ts
# The CLI inspects auth.options, generates PG-compatible SQL, and applies it.
# It is idempotent — safe to re-run after Better Auth upgrades.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Solo / no-auth mode — skips login entirely (everyone is the single admin).
# Set to "true" for local dev or single-user self-hosted deployments.
AUTH_DISABLED=true

# ─── Social providers (omit any you don't want) ────────────────────────────
# Google: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers → OAuth Apps
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ─── External OIDC SSO (for self-hosters with their own IdP) ───────────────
# Works with Keycloak, Authentik, Authelia, Okta, Entra, etc.
# OIDC_ISSUER must expose /.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=
