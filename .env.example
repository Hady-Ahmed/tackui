# ─── Database ──────────────────────────────────────────────────────────────
# Required. Postgres connection string.
DATABASE_URL=

# Optional pool tuning.
# PG_POOL_MAX=10
# PG_CONNECT_TIMEOUT=8000

# ─── Auth ───────────────────────────────────────────────────────────────────
# Required unless AUTH_DISABLED=true. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public base URL of the app. OAuth callback URLs derive from this.
BETTER_AUTH_URL=http://localhost:3000

# Solo / no-auth mode. NEVER expose an AUTH_DISABLED=true app to the internet.
# AUTH_DISABLED=true

# ─── Social login (optional) ────────────────────────────────────────────────
# Callback: {BETTER_AUTH_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Callback: {BETTER_AUTH_URL}/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ─── OIDC SSO (optional) ───────────────────────────────────────────────────
# Works with Keycloak, Authentik, Okta, Entra, etc.
# Callback: {BETTER_AUTH_URL}/api/auth/callback/oidc
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=

# ─── Email (optional — Resend) ───────────────────────────────────────────────
# When set, enables email verification and password resets.
# RESEND_API_KEY=
# EMAIL_FROM=noreply@yourdomain.com

# ─── Security ────────────────────────────────────────────────────────────────
# Encrypt secrets at rest (AES-256-GCM): agent JWT secrets, BYOK credential
# fields, connector tokens, and catalog template JWT secrets. 32-byte hex key.
# Generate with: openssl rand -hex 32
# REQUIRED unless solo mode (AUTH_DISABLED=true) — outside solo mode the app
# refuses to boot without it (storing tenant secrets in plaintext is never
# acceptable). Solo mode may leave it unset (plaintext + boot warning).
# Rotating the key requires re-saving each secret (see README).
# DB_ENCRYPTION_KEY=

# Allow agent endpoints that resolve to private/internal IPs.
# Default false = SSRF protection enabled.
# Set to true if your agent backends run on localhost or inside a private network.
# ALLOW_PRIVATE_ENDPOINTS=false

# Number of trusted reverse-proxy hops in front of this server.
# Default 1 (standard for Vercel / Railway / single Nginx ingress).
# Set to 2 for Cloudflare -> Nginx -> app.
# TRUSTED_PROXY_HOPS=1

# Trust the Cloudflare-supplied CF-Connecting-IP header for rate-limit keying.
# Only for deploys where Cloudflare is in front AND the next hop overwrites
# X-Forwarded-For with the Cloudflare edge IP (e.g. Cloudflare -> Traefik).
# Defaults to following SAAS_MODE (trusted in SaaS mode). Leave unset on
# deploys without Cloudflare: there the header is client-suppliable, and
# trusting it would let an attacker rotate it to reset every IP-keyed
# rate-limit bucket.
# TRUST_CF_CONNECTING_IP=false

# Max wall-clock time (ms) a concurrent-run slot is held before auto-releasing.
# Default 10 min (600000 ms). Minimum 60000 ms.
# CONCURRENT_RUN_TIMEOUT_MS=600000

# Override the per-user agentRead rate limit — the read bucket charged by
# /agents and the sidebar plus the catalog, models, tools, connectors,
# and credentials routes. Default 60/min. Any positive integer overrides
# the preset (in both directions — tighten as well as relax); junk, zero,
# and negatives keep the preset so a typo can't disable the limit. For
# busy self-hosted instances with many humans on one deployment.
# AGENT_READ_RATE_MAX=600

# Override the per-IP global flood limit on all /api routes. Default
# 300/min. Same override rules as AGENT_READ_RATE_MAX. For deployments
# where many humans (or one CI runner) share a single public IP: the
# flood bucket sees the aggregate of all that traffic, not each user's
# own share.
# GLOBAL_IP_RATE_MAX=1200

# Override Better Auth's per-IP sign-in limit. Default 10/min — but note
# Better Auth's in-memory counter only resets after a quiet gap larger
# than the whole window (not on a rolling schedule), so sustained
# sub-rate traffic accumulates until it trips. Deployment kinds that
# legitimately exceed it (many humans behind one NAT, a test suite with
# many logins) need explicit headroom.
# AUTH_SIGNIN_RATE_MAX=30

# ─── Error tracking (optional — Sentry) ─────────────────────────────────────
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Analytics (optional — Umami self-hosted) ───────────────────────────────
# NEXT_PUBLIC_UMAMI_URL=https://analytics.yourdomain.com
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id

# ─── Telemetry (CopilotKit runtime) ─────────────────────────────────────────
# The CopilotKit runtime sends anonymous usage telemetry to CopilotKit's
# collector by default. Set to true to disable it — the standard
# DO_NOT_TRACK=1 env var is honored too.
COPILOTKIT_TELEMETRY_DISABLED=true

# ─── Agent builder (optional) ───────────────────────────────────────────────
# Base URL of the agent builder service and the HS256 secret shared
# with its dispatcher. The URL alone activates the builder; when unset
# the builder is disabled (routes return 503, UI shows a disabled
# state). The secret is required for runs to succeed — without it every
# run fails auth at the dispatcher. No trailing slash on the URL.
# Generate the secret with: openssl rand -hex 32
# AGENTOS_BASE_URL=http://localhost:7778
# AGENTOS_JWT_SECRET=
#
# With the bundled docker-compose.dev.yml stack, AGENTOS_BASE_URL
# defaults to the compose service (http://agent-builder:7778) so only
# the secret is needed. The compose stack adds these variables:
# AGENTOS_DB_PASSWORD=   # db-builder Postgres password (default: agentos)
# AGENTOS_SENTRY_DSN=    # the builder service's own Sentry DSN

# ─── SaaS mode (leave unset for self-host) ──────────────────────────────────
# SAAS_MODE=true turns on the hosted-SaaS behaviour set: marketing landing
# page at /, chat at /app, billing UI, plan enforcement, and the SSRF guard
# hard-locked ON (ALLOW_PRIVATE_ENDPOINTS is ignored). Self-hosters leave
# this unset — never set it on a deployment that shares your private network
# with other services.
# SAAS_MODE=true

# Billing only mounts when SAAS_MODE=true AND a Stripe secret key is set.
# Without Stripe, SaaS mode still runs — every org sits on the Free plan.
# STRIPE_SECRET_KEY=sk_live_or_test_key
# Webhook signing secret (Stripe dashboard → webhook endpoint).
# STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs created in the Stripe dashboard; they map to the pro/team plans.
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_TEAM=price_...