# ───────────────────────────────────────────────────────────────────────────
# AG-UI Chat — Environment Variables
# ───────────────────────────────────────────────────────────────────────────
#
# Quickstart:
#   docker-compose up                              # solo mode, no auth
#   # OR for auth-enabled:
#   BETTER_AUTH_SECRET=$(openssl rand -hex 32) \
#   AUTH_DISABLED=false docker-compose up
#
# Manual setup:
#   1. Set DATABASE_URL
#   2. npm run migrate                               (app tables)
#   3. npx @better-auth/cli migrate --config lib/auth/auth.ts  (auth tables)
#   4. Set BETTER_AUTH_SECRET + BETTER_AUTH_URL
#   5. npm run dev  →  open http://localhost:3000
#
# First user to sign up becomes the admin. Then add agents via /agents.
#
# NOTE: Env changes require a dev server restart (Ctrl+C → npm run dev).
# Next.js reads .env.local at boot; it does not hot-reload env vars.
# Module-level `const X = process.env.X === "true"` patterns (proxy.ts,
# lib/auth/auth.ts, lib/net/safe-fetch.ts) are evaluated once at boot.
#
# Copy this file to `.env.local` and fill in the values you need.
# Every variable below is commented out — uncomment and set the ones you need.

# ─── Database ───────────────────────────────────────────────────────────────
# Required. Postgres connection string. Format:
#   postgres://USER:PASSWORD@HOST:PORT/DBNAME[?sslmode=require]
#
# Examples:
#   Local Postgres:    postgres://postgres:postgres@localhost:5432/agent_frontend
#   docker-compose:    postgres://postgres:postgres@db:5432/agent_frontend
#   Neon (SaaS):       postgres://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
#   Supabase (SaaS):   postgres://postgres:xxx@db.xxx.supabase.co:5432/postgres
DATABASE_URL=

# ─── Postgres Pool Tuning (optional) ────────────────────────────────────────
# Max connections in the pool. Default: 10. Increase if you expect high
# concurrency or see "connection timeout" errors under load.
# PG_POOL_MAX=10

# Connection timeout in milliseconds. Default: 5000 (5s). Increase if PG
# is on a high-latency network (e.g. managed DB in another region).
# PG_CONNECT_TIMEOUT=5000

# ─── Auth ───────────────────────────────────────────────────────────────────
# Required unless AUTH_DISABLED=true. The app refuses to boot without it
# when auth is enabled — a missing secret would silently sign sessions with
# a publicly-known value, allowing account forgery.
#
# Generate a secret with:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=

# Required unless AUTH_DISABLED=true. The public base URL of the app.
# Must match the URL users actually visit (including port if non-standard).
# OAuth callback URLs are derived from this (e.g. {BETTER_AUTH_URL}/api/auth/callback/google).
BETTER_AUTH_URL=http://localhost:3000

# Solo / no-auth mode. Set to "true" to skip login entirely — everyone who
# can reach the app is the admin. Useful for local dev or single-user
# self-hosted deployments. NEVER expose an AUTH_DISABLED=true app to the
# internet or untrusted users.
# AUTH_DISABLED=true

# ─── Google OAuth (optional) ────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Callback URL: {BETTER_AUTH_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── GitHub OAuth (optional) ────────────────────────────────────────────────
# https://github.com/settings/developers → OAuth Apps
# Callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ─── External OIDC SSO (optional) ───────────────────────────────────────────
# Works with Keycloak, Authentik, Authelia, Okta, Entra, etc.
# OIDC_ISSUER must expose /.well-known/openid-configuration
# Callback URL: {BETTER_AUTH_URL}/api/auth/callback/oidc
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=

# ─── Security (optional) ───────────────────────────────────────────────────
# SSRF protection for agent creation/editing. When false (default), creating
# or editing an agent with an endpoint that resolves to a private/internal IP
# (127.x, 10.x, 192.168.x, 172.16-31.x, 169.254.x, IPv6 equivalents) is blocked
# to prevent Server-Side Request Forgery. The "Test connection" probe is not
# gated — it always reports reachability truthfully.
#
# Set to "true" if your agent backends run on the same host as the frontend
# (e.g. http://localhost:8001/agent). Safe when only trusted users can reach
# the admin page. Existing agents keep working regardless of this setting.
# ALLOW_PRIVATE_ENDPOINTS=false


