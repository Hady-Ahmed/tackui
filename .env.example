# ─── Database ──────────────────────────────────────────────────────────────
# Required. Postgres connection string.
DATABASE_URL=

# Optional pool tuning.
# PG_POOL_MAX=10
# PG_CONNECT_TIMEOUT — connection timeout in ms (default 5000). Bump to ~8000
# if your DB has cold-start latency (e.g. Neon scale-to-zero).
# PG_CONNECT_TIMEOUT=8000

# ─── Auth ───────────────────────────────────────────────────────────────────
# Required unless AUTH_DISABLED=true. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public base URL of the app. OAuth callback URLs derive from this.
BETTER_AUTH_URL=http://localhost:3000

# Solo / no-auth mode. NEVER expose an AUTH_DISABLED=true app to the internet.
# AUTH_DISABLED=true

# ─── Social login (optional) ────────────────────────────────────────────────
# Callback: {BETTER_AUTH_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Callback: {BETTER_AUTH_URL}/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ─── OIDC SSO (optional) ───────────────────────────────────────────────────
# Works with Keycloak, Authentik, Okta, Entra, etc. OIDC_ISSUER must expose
# /.well-known/openid-configuration.
# Callback: {BETTER_AUTH_URL}/api/auth/callback/oidc
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=

# ─── Email (optional — Resend) ───────────────────────────────────────────────
# When set, enables email verification + password reset. When unset, disabled.
# RESEND_API_KEY=
# EMAIL_FROM=noreply@yourdomain.com

# ─── Security (optional) ────────────────────────────────────────────────────
# Allow agent endpoints that resolve to private/internal IPs (for self-hosters
# running backends on the same host). Default false = SSRF protection on.
# Has no effect under SAAS_MODE (the guard is hard-locked on there).
# ALLOW_PRIVATE_ENDPOINTS=false

# Number of trusted reverse-proxy hops in front of this server. The client IP
# is the Nth-from-RIGHT entry of X-Forwarded-For where N is this count.
# Default 1 (correct for Vercel / Railway / Render / a single Nginx in front —
# they all set the real client IP as the LAST entry). Set to 2 for
# Cloudflare -> Nginx -> app, 3 for three hops, etc. Without this, a malicious
# client could prepend a fake IP to X-Forwarded-For and bypass the per-IP
# rate limit (proxy.ts 300/min cap).
# TRUSTED_PROXY_HOPS=1

# Max wall-clock time (ms) a concurrent-run rate-limit slot can be held before
# the watchdog force-releases it. SAFETY NET only — the actual SSE stream /
# agent run is NOT cancelled, only the rate-limit counter is decremented.
# Prevents slot leaks when a client opens a run and drops TCP without
# triggering ReadableStream.cancel(). Default 10 min (generous for chat-style
# AG-UI token streaming). Floor 60_000 (1 min). Override if your agents do
# legitimately long research runs.
# CONCURRENT_RUN_TIMEOUT_MS=600000

# ─── Error tracking (optional — Sentry) ─────────────────────────────────────
# Server-side DSN (secret) and client-side DSN (public, exposed to browser).
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN — build-time only (inlined into client bundle at build).
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE — build-time only.
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── SaaS mode (hosted only — self-hosters ignore) ─────────────────────────
# Enables landing page, billing, plan enforcement, forced SSRF guard.
# SAAS_MODE=true
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_TEAM=
