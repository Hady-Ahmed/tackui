# Shared HS256 secret — MUST equal the frontend's AGENTOS_JWT_SECRET (the
# frontend mints the user + service tokens this service verifies).
JWT_SECRET=

# Postgres (Neon in prod, local Postgres in dev) — components/sessions (agno,
# `ai` schema) AND the catalog tables (`public` schema). Same DATABASE_URL
# pattern as the other agents.
DATABASE_URL=postgresql://user:password@localhost:5432/platform_os

# Platform model keys — the FALLBACK tier. Runner keys arrive per run and win.
# SaaS leaves these UNSET: runners must bring their own keys (the client's run
# gate 402s without one), and an env key here would let any run silently spend
# the platform's money. Self-host fallback only.
OPENAI_API_KEY=
# Optional: platform key for OpenRouter-hosted models (e.g. GLM). Same SaaS
# discipline — unset in SaaS.
OPENROUTER_API_KEY=

# Optional platform Tavily key — fallback when a runner supplies none.
# SaaS leaves this unset: runners must bring their own Tavily key.
TAVILY_API_KEY=

# The builder catalog (which models/tools are offered) is NOT configured
# here anymore — it lives in the catalog db and is managed by the platform
# admin via the frontend's /admin/platform page (or the /platform/catalog
# API). Tables start EMPTY; tick the boxes once after deploying.
# The retired env vars PLATFORM_MODELS / PLATFORM_TOOLS / PLATFORM_TIER_MODELS
# are gone — nothing reads them and they are silently ignored; remove them.

# Server binding (Railway sets PORT automatically). This service's default
# dev port is 7778 (main.py) — different from the chat agents' 7777 so
# platform-os and an agent can run side by side.
AGENT_OS_HOST=0.0.0.0
AGENT_OS_PORT=7778

# Per-connector MCP handshake cap during run attach (seconds). A hung
# endpoint must not hold the run start (member spinner + occupied
# concurrent-run slot). Default 20; raise it only for slow internal
# networks. A typo'd value falls back to 20 rather than failing boot.
# MCP_ATTACH_TIMEOUT_SECONDS=20

# Optional error tracking (Sentry). Unset = disabled (self-host default).
# Create a Sentry project, paste its DSN here. SENTRY_ENVIRONMENT tags the
# events ("production" by default, or the Railway environment name).
SENTRY_DSN=
